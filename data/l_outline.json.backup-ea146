                      "major_task_group_title": "Virtue",
                      "major_task_group_description": "Virtue emphasizes the deliberate cultivation of moral excellence—qualities like integrity, compassion, and fairness—to guide personal conduct. By consciously developing virtuous habits, individuals elevate their interactions with others, shape ethical decision-making, and contribute to healthier communities. Whether through self-reflection, consistent practice, or mindful engagement with broader societal concerns, the pursuit of virtue fosters both internal harmony and external goodwill.",
                      "major_task_group_tagline": "Elevating moral character as the bedrock of integrity and societal well-being.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Nicomachean Ethics by Aristotle",
                        "book2": "Moral Tribes by Joshua Greene",
                        "book3": "After Virtue by Alasdair MacIntyre",
                        "book4": "The Road to Character by David Brooks",
                        "book5": "Practical Ethics by Peter Singer",
                        "book6": "Justice: What's the Right Thing to Do? by Michael J. Sandel",
                        "book7": "The Righteous Mind by Jonathan Haidt"
                      },
