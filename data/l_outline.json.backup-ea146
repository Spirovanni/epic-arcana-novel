                    "major_task_group_4": {
                      "unique_identifier": "MTG 2.1.4",
                      "type": "Major Task Group",
                      "color_name": "Carmine",
                      "hex_code": "#AA1A11",
                      "red": "170",
                      "green": "26",
                      "blue": "17",
                      "major_task_group_title": "Resilience",
                      "major_task_group_description": "Resilience is the capacity to recover quickly from setbacks, remain steadfast in the face of difficulties, and adapt to ever-changing circumstances. By cultivating mental toughness, emotional agility, and a proactive mindset, individuals can transcend adversity, learning to turn challenges into catalysts for personal growth and inner strength.",
                      "major_task_group_tagline": "Resilience is the ability to face adversity head-on and emerge stronger than before.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Option B by Sheryl Sandberg and Adam Grant",
                        "book2": "The Power of Habit by Charles Duhigg",
                        "book3": "Rising Strong by Brené Brown",
                        "book4": "Antifragile by Nassim Nicholas Taleb",
                        "book5": "Grit: The Power of Passion and Perseverance by Angela Duckworth",
                        "book6": "Deep Survival by Laurence Gonzales",
                        "book7": "The Resilience Factor by Karen Reivich and Andrew Shatté"
                      },
                      "Specific_task_groups": {
                        "specific_task_group_1": {
                          "id": "EA-050",
                          "unique_identifier": "STG 2.1.4.1",
