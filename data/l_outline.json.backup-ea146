                          "epic_novel_pages": "Page 376 - 390",
                          "epic_chapter_focus": "Old world contrast (resolution)",
                          "epic_preliminary_scene_focus": "Approach to the Innermost Cave",
                          "epic_preliminary_scene_description": "Juxtaposing scarcity with present abundance illuminates new responsibilities inherent in prosperity.",
                          "epic_novel_chapter_focus": "Scene VII: The Road of Trials",
                          "epic_novel_section_name": "Part II: The Magus Of Power",
                          "specific_task_group_title": "Balance",
                          "focus_area": "Wellness",
                          "connection_to_the_major_task_group": "Balance integrates physical, emotional, and cognitive dimensions, anchoring wellness as the keystone of sustained performance.",
                          "specific_task_group_description": "Balance is the art of distributing attention and resources across life’s domains to maintain equilibrium. Through deliberate rest and self‑regulation, individuals prevent burnout and amplify creativity.",
                          "specific_task_group_tagline": "Equilibrium empowers enduring excellence.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Rest: Why You Get More Done When You Work Less",
                              "author": "Alex Soojung‑Kim Pang",
                              "section_of_focus": "Deliberate Rest",
                              "section_description": "Explores the science of rest, showing how structured breaks amplify productivity and health.",
                              "connection_focus_area": "Highlights rest as an integral component of balanced excellence.",
                              "connect_points": {
                                "point1": "Incorporate naps and digital sabbaths into routines.",
                                "point2": "Define “productive rest” aligned with personal needs.",
                                "point3": "Track performance improvements linked to rest."
                              },
                              "terminal_learning_objectives": {
                                "objective1": "Develop a personalized rest regimen.",
                                "objective2": "Measure rest’s impact on creativity.",
                                "objective3": "Adjust rest strategies based on performance data."
                              }
                            },
                            "book2": {
                              "title": "The Balanced Life",
                              "author": "Alan Loy McGinnis",
                              "section_of_focus": "Life Prioritization",
                              "section_description": "Offers strategies to align values with daily choices, reducing stress and enhancing fulfillment.",
                              "connection_focus_area": "Provides tools to craft a personal equilibrium plan.",
                              "connect_points": {
                                "point1": "Identify core life domains and allocate time mindfully.",
                                "point2": "Establish non‑negotiable boundaries for rest.",
                                "point3": "Use regular check‑ins to recalibrate balance."
                              },
                              "terminal_learning_objectives": {
                                "objective1": "Map personal priorities to structured routines.",
                                "objective2": "Implement boundaries to protect well‑being.",
                                "objective3": "Evaluate balance metrics quarterly."
                              }
                            },
                            "book3": {
                              "title": "The Power of Full Engagement",
                              "author": "Jim Loehr & Tony Schwartz",
                              "section_of_focus": "Energy Management",
                              "section_description": "Presents a model for managing energy rather than time, emphasizing oscillation between stress and renewal.",
                              "connection_focus_area": "Reframes balance as dynamic management of energy.",
                              "connect_points": {
                                "point1": "Schedule periods of high intensity and recovery.",
                                "point2": "Use rituals to facilitate energy shifts.",
                                "point3": "Monitor energy to predict performance peaks."
