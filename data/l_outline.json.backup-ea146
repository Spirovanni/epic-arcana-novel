                        "book5": "The Art of War by Sun Tzu",
                        "book6": "The Book of Five Rings by Miyamoto Musashi",
                        "book7": "The Prince by Niccolò Machiavelli"
                      },
                      "specific_task_groups": {
                        "specific_task_group_1": {
