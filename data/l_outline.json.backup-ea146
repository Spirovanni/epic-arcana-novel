                "task_master_2": {
                  "unique_identifier": "MT 6.2",
                  "type": "Task Master",
                  "color_name": "Turquoise",
                  "hex_code": "#3CDDC8",
                  "red": "60",
                  "green": "221",
                  "blue": "200",
                  "title": "Transformation - On Death Ground",
                  "tagline": "In moments of greatest peril, true transformation emerges.",
                  "description": "Transformation - On Death Ground highlights the profound metamorphosis that arises when individuals are driven to their limits. Inspired by the strategic concept of 'death ground,' in which there is no safe path of retreat, this Task Master embodies the idea that formidable personal changes often occur in moments of dire necessity. By accepting the inevitability of change and confronting challenges head-on, individuals can spark new growth, deepen their capabilities, and unlock unforeseen potential.",
                  "fiction_novel_section_title": "Child of the Great Transformers",
                  "fiction_novel_section_description": "In the fictional novel 'Child of the Great Transformers,' a shattered kingdom stands on the brink of collapse. With invading forces all around and nowhere to escape, the protagonist is forced to embrace a fierce inner shift to adapt and survive. Overcoming fear, she taps into a hidden power that reshapes not only her own destiny but the fate of her people. 'Death ground' becomes the crucible in which her transformation is forged, highlighting the unbreakable link between profound change and necessity.",
                  "fiction_novel_section_tagline": "No refuge, no retreat—only the unstoppable force of transformation.",
                  "fiction_novel_section_books_influenced_by": {
                    "book1": "The Broken Earth Trilogy by N.K. Jemisin",
                    "book2": "Station Eleven by Emily St. John Mandel",
                    "book3": "Uprooted by Naomi Novik",
                    "book4": "Children of Blood and Bone by Tomi Adeyemi",
                    "book5": "The Dragon Republic by R.F. Kuang",
                    "book6": "A Court of Thorns and Roses by Sarah J. Maas",
                    "book7": "Dune by Frank Herbert"
                  },
                  "major_task_groups": {
                    "major_task_group_1": {
                      "unique_identifier": "MTG 6.2.1",
                      "type": "Major Task Group",
                      "color_name": "Columbia Blue",
