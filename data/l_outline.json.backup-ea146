                          "specific_task_group_title": "Seek Prosperity",
                          "focus_area": "Abundance",
                          "connection_to_the_major_task_group": "Recognizing and amplifying opportunity transforms fleeting gains into sustained growth.",
                          "specific_task_group_description": "Seek Prosperity teaches strategies to attract, manage, and multiply resources—laying the groundwork for long‑term flourishing.",
