                      "major_task_group_title": "Dynamism",
                      "major_task_group_description": "Dynamism captures the unstoppable drive that fuels progress and transformation. It centers on harnessing both physical and mental energy to overcome obstacles, adapt to change, and seize emerging opportunities. By cultivating a spirit of agility, passion, and innovative thinking, individuals and teams can channel their momentum toward meaningful growth—energizing themselves and the communities they serve.",
                      "major_task_group_tagline": "Amplifying forward momentum to ignite transformation and boundless possibility.",
                      "major_task_group_books_influenced_by": {
                        "book1": "The Lean Startup by Eric Ries",
                        "book2": "Shoe Dog by Phil Knight",
                        "book3": "Grit: The Power of Passion and Perseverance by Angela Duckworth",
                        "book4": "Flow: The Psychology of Optimal Experience by Mihaly Csikszentmihalyi",
                        "book5": "Peak: Secrets from the New Science of Expertise by Anders Ericsson and Robert Pool",
                        "book6": "Atomic Habits by James Clear",
                        "book7": "Can't Hurt Me by David Goggins"
                      },
