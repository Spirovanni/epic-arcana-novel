                      "major_task_group_title": "Transformation",
                      "major_task_group_description": "Transformation is the profound process by which individuals, organizations, or societies undergo meaningful change. It involves dismantling old habits, paradigms, or limitations and re-envisioning what is possible. By embracing vulnerability, resilience, and innovation, people can break free from routines that no longer serve them and open pathways to personal evolution. Through consistent self-reflection and decisive action, transformation enables the discovery of deeper purpose and renewed direction.",
                      "major_task_group_tagline": "Breaking old patterns to forge a renewed vision and purpose.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Switch: How to Change Things When Change Is Hard by Chip Heath & Dan Heath",
                        "book2": "Immunity to Change by Robert Kegan & Lisa Laskow Lahey",
                        "book3": "Atomic Habits by James Clear",
                        "book4": "The Art of Possibility by Rosamund Stone Zander & Benjamin Zander",
                        "book5": "Mindset: The New Psychology of Success by Carol S. Dweck",
                        "book6": "Reinventing Organizations by Frederic Laloux",
                        "book7": "Designing Your Life by Bill Burnett & Dave Evans"
                      },
