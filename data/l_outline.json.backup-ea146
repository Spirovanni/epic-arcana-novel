                          "save_the_cat_beat_goal": "",
                          "plot": "Battle (set-up)",
                          "character_arcs": {
                            "Francisco": "Rediscovers the wonder and innocence that originally motivated his quest for knowledge and power.",
                            "Inner_Child": "Francisco's connection to his youthful enthusiasm and sense of possibility.",
                            "Wonder_Recovery": "Reclaiming the ability to see beauty and possibility even in dark circumstances.",
