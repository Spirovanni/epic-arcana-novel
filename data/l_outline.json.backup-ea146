                          "epic_novel_section_name": "Part II: The Magus Of Power",
                          "specific_task_group_title": "Ambition",
                          "focus_area": "Achievement",
                          "connection_to_the_major_task_group": "Harnessing drive to set and attain lofty goals.",
                          "specific_task_group_description": "Ambition propels individuals beyond comfort zones, inspiring disciplined pursuit of excellence. When tempered with purpose, it becomes a force for transformational progress.",
                          "specific_task_group_tagline": "Aim high, achieve higher.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Atomic Habits",
                              "author": "James Clear",
                              "section_of_focus": "Building Good Habits",
