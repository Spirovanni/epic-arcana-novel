                          "epic_novel_pages": "Pages 211 - 225",
                          "epic_chapter_focus": "New world (set‑up)",
                          "epic_preliminary_scene_focus": "Tests, Allies and Enemies",
                          "epic_preliminary_scene_description": "A burgeoning realm of possibility unfolds, and characters must channel their deepest emotions into creative strategies to navigate emergent complexities.",
                          "epic_novel_chapter_focus": "Scene VI: Guardians and Gatekeepers",
                          "epic_novel_section_name": "Part II: Chief Among the Mighty",
                          "specific_task_group_title": "Creative Force",
                          "focus_area": "Creativity",
                          "connection_to_the_major_task_group": "Harnessing imagination fuels breakthroughs and inspires collective ingenuity.",
                          "specific_task_group_description": "Creative Force invites participants to transform emotional insight into innovative solutions, leveraging empathy and vision to unlock new pathways forward.",
                          "specific_task_group_tagline": "Imagine, then create.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Creative Confidence",
                              "author": "Tom Kelley & David Kelley",
                              "section_of_focus": "Unlocking Innovation",
                              "section_description": "Reveals methods for tapping into one’s inherent creative potential to solve problems in novel ways.",
                              "connection_focus_area": "Demonstrates how belief in one’s creative abilities accelerates collaborative invention.",
                              "connect_points": {
                                "point1": "Adopt rapid ideation techniques (e.g., brainstorming, sketching).",
                                "point2": "Cultivate a permission‑to‑fail mindset in teams.",
                                "point3": "Use prototyping to communicate and refine ideas."
                              },
                              "terminal_learning_objectives": {
                                "objective1": "Facilitate a quick‑fire ideation session.",
                                "objective2": "Build low‑fidelity prototypes for top concepts.",
                                "objective3": "Gather user feedback to iterate on designs."
                              }
                            },
                            "book2": {
                              "title": "Steal Like an Artist",
                              "author": "Austin Kleon",
                              "section_of_focus": "Creative Remixing",
                              "section_description": "Encourages borrowing and transforming ideas from diverse sources to develop one’s unique creative voice.",
                              "connection_focus_area": "Illustrates how remixing existing concepts sparks original innovation.",
                              "connect_points": {
                                "point1": "Collect inspiration from unrelated fields.",
                                "point2": "Distill and remix existing ideas into new forms.",
                                "point3": "Share creations to invite collaborative enhancement."
