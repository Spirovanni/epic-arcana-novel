                          "epic_novel_pages": "Pages 211 - 225",
                          "epic_chapter_focus": "New world (set‑up)",
                          "epic_preliminary_scene_focus": "Tests, Allies and Enemies",
                          "epic_preliminary_scene_description": "Entering a redefined landscape, characters must project belief in themselves to rally allies and deter foes. Authentic confidence becomes both armor and beacon.",
                          "epic_novel_chapter_focus": "Scene VI: Guardians and Gatekeepers",
                          "epic_novel_section_name": "Part II: The Magus Of Power",
                          "specific_task_group_title": "Confidence",
                          "focus_area": "Self‑Esteem",
                          "connection_to_the_major_task_group": "True confidence empowers decisive leadership and attracts collaborative support.",
                          "specific_task_group_description": "Confidence stems from self‑trust, earned competence, and internal validation. By nurturing self‑esteem, individuals communicate clarity and inspire collective momentum, especially amid uncertainty.",
                          "specific_task_group_tagline": "Lead from within, shine without.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "The Six Pillars of Self‑Esteem",
                              "author": "Nathaniel Branden",
                              "section_of_focus": "Personal Practices",
