                                "objective2": "Practice post‑traumatic growth mindsets.",
                                "objective3": "Design support rituals for recovery."
                              }
                            },
                            "book2": {
                              "title": "Antifragile",
                              "author": "Nassim Nicholas Taleb",
                              "section_of_focus": "Benefiting from Disorder",
                              "section_description": "Argues that stressors and shocks can strengthen systems rather than merely damage them.",
                              "connection_focus_area": "Reframes breakdown as fuel for adaptive gains.",
