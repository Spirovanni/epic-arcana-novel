                  "green": "242",
                  "blue": "128",
                  "title": "Restructuring",
                  "tagline": "Rebuilding what’s broken to forge a stronger, more purposeful future.",
                  "description": "Restructuring is the intentional process of dismantling outmoded structures—whether they are habits, systems, or mindsets—and reorganizing them to promote renewal and sustainable growth. It acknowledges that progress often demands letting go of what no longer serves us, creating space for innovative solutions and fresh perspectives. By embracing restructuring, individuals and communities alike can adapt, refocus, and rebuild with greater clarity and purpose.",
                  "fiction_novel_section_title": "Lord of the Host of the Mighty",
                  "fiction_novel_section_description": "In this fictional narrative, a vast empire stands at a crossroads: its once-unified legions, the \"Host of the Mighty,\" are fraying under corrupt leadership and outdated doctrines. The protagonist, an idealistic commander, embarks on a bold campaign of restructuring—dismantling old hierarchies, forging unexpected alliances, and inviting voices typically silenced to guide the transformation. As the empire’s power brokers resist these sweeping reforms, tensions mount, testing the depth of the protagonist’s resolve and vision. Ultimately, this reordering proves essential to forging a future founded on equity, cooperation, and renewed strength.",
                  "fiction_novel_section_tagline": "When ancient structures crumble, new possibilities emerge from the ruins.",
                  "fiction_novel_section_books_influenced_by": {
                    "book1": "The Traitor Baru Cormorant by Seth Dickinson",
                    "book2": "The Goblin Emperor by Katherine Addison",
                    "book3": "Foundryside by Robert Jackson Bennett",
                    "book4": "The Grace of Kings by Ken Liu",
                    "book5": "A Memory Called Empire by Arkady Martine",
                    "book6": "The Fifth Season by N.K. Jemisin",
                    "book7": "Elantris by Brandon Sanderson"
                  },
                  "major_task_groups": {
                    "major_task_group_1": {
                      "unique_identifier": "MTG 7.3.1",
                      "type": "Major Task Group",
                      "color_name": "Forest Green",
                      "hex_code": "#118022",
                      "red": "17",
                      "green": "128",
                      "blue": "34",
                      "major_task_group_title": "Adaptive Transition",
                      "major_task_group_description": "Adaptive Transition is the practice of evolving smoothly through challenges, using resilience and strategic shifts to stay aligned with emerging realities.",
                      "major_task_group_tagline": "Thrive through change by proactively embracing new pathways of growth.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Switch: How to Change Things When Change Is Hard by Chip Heath and Dan Heath",
                        "book2": "Who Moved My Cheese? by Spencer Johnson",
                        "book3": "Managing Transitions by William Bridges",
                        "book4": "Adaptive Capacity by Juan Carlos Eichholz",
                        "book5": "Transitions: Making Sense of Life's Changes by William Bridges",
                        "book6": "Resilience by Eric Greitens",
                        "book7": "Leading Change by John P. Kotter"
                      },
