                          "connection_to_the_major_task_group": "Turning plans into action under pressure, marshaling resources to deliver results.",
                          "specific_task_group_description": "Deployment is the art of executing strategies efficiently, coordinating teams and assets to achieve mission goals. It requires clarity, adaptability, and relentless follow‑through to convert vision into tangible outcomes.",
                          "specific_task_group_tagline": "Execute with precision, deliver with impact.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "The 4 Disciplines of Execution",
                              "author": "Chris McChesney, Sean Covey & Jim Huling",
