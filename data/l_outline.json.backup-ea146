                "task_master_2": {
                  "unique_identifier": "MT 7.2",
                  "type": "Task Master",
                  "color_name": "Sea Green",
                  "hex_code": "#2F8F4F",
                  "red": "47",
                  "green": "143",
                  "blue": "79",
                  "title": "Materiality",
                  "tagline": "Shaping our world through tangible creation and grounded purpose.",
                  "description": "Materiality focuses on the significance of the physical realm, where ideas and intentions take concrete form. It underscores the importance of manifestation, resourcefulness, and pragmatic thinking. By engaging with the tangible world—be it technology, craftsmanship, or environment—individuals can forge purposeful outcomes that bridge ambition with reality. Materiality reminds us that innovation, progress, and resilience are realized by engaging wholeheartedly with the substance of everyday life.",
                  "fiction_novel_section_title": "Lord of the Gates of Matter",
                  "fiction_novel_section_description": "In this epic fantasy, the realm’s stability hinges on a delicate balance between ethereal magic and the physical resources that sustain civilization. The protagonist, entrusted with safeguarding the literal ‘gates of matter,’ must unite disparate factions that have long neglected the raw materials underpinning their prosperity. As rivalries simmer and the precious gates face destruction, he learns that safeguarding the tangible foundations of a society is both an act of courage and a moral responsibility—showcasing the profound link between vision and the material building blocks of the world.",
                  "fiction_novel_section_tagline": "When ideals meet the bedrock of reality, a new destiny takes shape.",
                  "fiction_novel_section_books_influenced_by": {
                    "book1": "The Stone Sky by N.K. Jemisin",
                    "book2": "The Dwarves by Markus Heitz",
                    "book3": "The Fifth Head of Cerberus by Gene Wolfe",
                    "book4": "The Iron Dragon’s Daughter by Michael Swanwick",
                    "book5": "The Alloy of Law by Brandon Sanderson",
                    "book6": "Foundryside by Robert Jackson Bennett",
                    "book7": "The Bone Clocks by David Mitchell"
                  },
                  "major_task_groups": {
                    "major_task_group_1": {
                      "unique_identifier": "MTG 7.2.1",
                      "type": "Major Task Group",
                      "color_name": "Padua",
