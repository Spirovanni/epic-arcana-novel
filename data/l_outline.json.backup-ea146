                      "major_task_group_title": "Strategic Patience",
                      "major_task_group_description": "Strategic Patience promotes purposeful restraint and long-range thinking in the face of challenges or opportunities. Rather than rushing decisions or forcing outcomes, individuals practicing Strategic Patience evaluate the broader context, adapt to evolving dynamics, and deliberately time their actions. This balanced approach embraces discipline, foresight, and steady perseverance, ultimately generating more durable success and fostering deeper resilience.",
                      "major_task_group_tagline": "Cultivating measured action and foresight for lasting growth and resilient outcomes.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Wait: The Art and Science of Delay by Frank Partnoy",
                        "book2": "The Marshmallow Test by Walter Mischel",
                        "book3": "Thinking, Fast and Slow by Daniel Kahneman",
                        "book4": "The Compound Effect by Darren Hardy",
                        "book5": "Grit: The Power of Passion and Perseverance by Angela Duckworth",
                        "book6": "Atomic Habits by James Clear",
                        "book7": "Range by David Epstein"
                      },
