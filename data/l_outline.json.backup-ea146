                              "timelineSignificance": "Seeding operation Day 4—critical failure from team exhaustion threatening mission.",
                              "saveTheCatBeat": "All Is Lost - team burnout creates critical failure",
                              "sudowrite_metadata": {
                                "intensity": "very high",
                                "pacing": "high_anxiety",
