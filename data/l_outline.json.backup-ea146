                      "major_task_group_title": "Heroism",
                      "major_task_group_description": "Heroism is the act of courage, sacrifice, and service that inspires individuals to overcome adversity, challenges, and obstacles. It involves embodying virtues, values, and beliefs that reflect honor, integrity, and compassion. Heroism is the foundation of personal growth, professional development, and lifelong learning. By cultivating heroism within oneself and with others, individuals can create a purposeful and meaningful life that enables them to thrive and flourish. The act of courage, sacrifice, and service that inspires individuals to overcome adversity, challenges, and obstacles.",
                      "major_task_group_tagline": "Heroism is the act of courage, sacrifice, and service that inspires individuals to overcome adversity, challenges, and obstacles.",
                      "major_task_group_books_influenced_by": {
                        "book1": "The Hero with a Thousand Faces by Joseph Campbell",
                        "book2": "Beowulf by Unknown",
                        "book3": "The Odyssey by Homer",
                        "book4": "The Iliad by Homer",
                        "book5": "The Aeneid by Virgil",
                        "book6": "Paradise Lost by John Milton",
                        "book7": "The Divine Comedy by Dante Alighieri"
                      },
                      "specific_task_groups": {
                        "specific_task_group_1": {
                          "id": "EA-033",
                          "unique_identifier": "STG 1.3.4.1",
