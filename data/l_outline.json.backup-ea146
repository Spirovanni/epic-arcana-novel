                      "major_task_group_books_influenced_by": {
                        "book1": "Grit: The Power of Passion and Perseverance by Angela Duckworth",
                        "book2": "Mindset: The New Psychology of Success by Carol S. Dweck",
                        "book3": "The Upside of Stress by Kelly McGonigal",
                        "book4": "Man’s Search for Meaning by Viktor Frankl",
                        "book5": "Rising Strong by Brené Brown",
                        "book6": "Can’t Hurt Me by David Goggins",
                        "book7": "Daring Greatly by Brené Brown"
