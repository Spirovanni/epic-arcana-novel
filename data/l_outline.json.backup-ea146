                              "author": "Kelly McGonigal",
                              "section_of_focus": "Mindset and Stress",
                              "section_description": "Demonstrates how viewing stress as enhancing boosts performance and health.",
                              "connection_focus_area": "Provides mindset tools to harness crisis energy.",
                              "connect_points": {
