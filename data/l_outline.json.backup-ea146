                        "specific_task_group_2": {
                          "id": "EA-005",
                          "unique_identifier": "STG 1.1.2.2",
                          "all_chapter": 5,
                          "chapter": "Chapter 5",
                          "type": "Specific Task Group",
                          "tarot_card_link": "",
