                          "specific_task_group_title": "Perseverance",
                          "focus_area": "Resilience",
                          "connection_to_the_major_task_group": "Long‑term resilience converts adversity into mastery through sustained effort.",
                          "specific_task_group_description": "Perseverance is steadfast determination despite fatigue or discouragement. It transforms obstacles into stepping‑stones, knitting confidence through repeated trials.",
                          "specific_task_group_tagline": "Persist until progress prevails.",
                          "specific_task_group_books_influenced_by": {
