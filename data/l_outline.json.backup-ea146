                      "major_task_group_title": "Positive Transformation",
                      "major_task_group_description": "Positive Transformation underscores the power of purposeful change aimed at personal growth and collective well-being. By focusing on constructive mindsets, supportive relationships, and proactive methods of self-improvement, individuals can overcome limiting beliefs, heal from past challenges, and cultivate a renewed sense of purpose. This process involves both introspection and deliberate action, inspiring people to embrace progress while honoring their core values and authentic self-expression.",
                      "major_task_group_tagline": "Evolving with intention to spark growth, resilience, and meaningful connections.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Mindset by Carol S. Dweck",
                        "book2": "Switch: How to Change Things When Change Is Hard by Chip Heath & Dan Heath",
                        "book3": "Atomic Habits by James Clear",
                        "book4": "The Power of Now by Eckhart Tolle",
                        "book5": "Awaken the Giant Within by Tony Robbins",
                        "book6": "Rising Strong by Brené Brown",
                        "book7": "Immunity to Change by Robert Kegan & Lisa Laskow Lahey"
                      },
