                          "specific_task_group_title": "Well‑Being",
                          "focus_area": "Health",
                          "connection_to_the_major_task_group": "Holistic health underpins sustained performance and clarity on the hero’s path.",
                          "specific_task_group_description": "Well‑being integrates physical fitness, mental stability, emotional balance, and spiritual fulfillment. By proactively nurturing these dimensions, individuals maximize resilience, judgment, and creative capacity.",
