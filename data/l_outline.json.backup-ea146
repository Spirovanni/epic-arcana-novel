                          "save_the_cat_beat": "Pressure",
                          "save_the_cat_beat_goal": "",
                          "plot": "Pressure",
                          "character_arcs": {
                            "Francisco": "Learns the importance of strategic withdrawal and careful planning in cosmic rebellion.",
                            "Costly_Setback": "The rebellion suffers losses that force Francisco to reconsider his approach.",
                            "Strategic_Reorganization": "Francisco develops more sophisticated methods for challenging cosmic authority.",
