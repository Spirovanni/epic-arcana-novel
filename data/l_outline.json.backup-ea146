                          "epic_novel_pages": "Pages 226 - 240",
                          "epic_chapter_focus": "Fun and games (event/conflict)",
                          "epic_preliminary_scene_focus": "Tests, Allies and Enemies",
                          "epic_preliminary_scene_description": "Tactical skirmishes of words and wits test communication prowess. Assertive clarity becomes the decisive edge that separates missteps from breakthroughs.",
                          "epic_novel_chapter_focus": "Scene VI: Guardians and Gatekeepers",
                          "epic_novel_section_name": "Part II: The Magus Of Power",
                          "specific_task_group_title": "Assertiveness",
                          "focus_area": "Communication",
                          "connection_to_the_major_task_group": "Assertiveness harmonizes respect for self with respect for others, driving transparent dialogue and effective collaboration.",
                          "specific_task_group_description": "Assertiveness blends confidence with empathy, enabling individuals to articulate needs and boundaries without aggression. Mastering this skill resolves conflict quickly, reduces misinterpretation, and builds trust across teams.",
                          "specific_task_group_tagline": "Speak truth with respect; listen with intent.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Crucial Conversations",
                              "author": "Patterson, Grenny, McMillan & Switzler",
                              "section_of_focus": "High‑Stakes Dialogue",
