                          "specific_task_group_title": "Legacy Building",
                          "focus_area": "Sustainability",
                          "connection_to_the_major_task_group": "Crafting a resilient foundation ensures that breakthroughs endure well beyond their moment of creation.",
                          "specific_task_group_description": "Legacy Building guides deliberate actions to embed your values and successes into systems that outlast individual efforts.",
                          "specific_task_group_tagline": "Build what lasts.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Good to Great",
                              "author": "Jim Collins",
                              "section_of_focus": "The Flywheel and the Doom Loop",
