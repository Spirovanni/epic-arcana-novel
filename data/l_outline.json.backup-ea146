                          "focus_area": "Wealth",
                          "connection_to_the_major_task_group": "Strategic investment turns short‑term gains into enduring prosperity, fueling future quests.",
                          "specific_task_group_description": "Investing leverages capital—time, money, energy—toward compounding returns. Wise stewardship aligns resources with values, balancing risk and opportunity to build lasting impact.",
                          "specific_task_group_tagline": "Plant wisely, harvest abundantly.",
