                    "major_task_group_3": {
                      "unique_identifier": "MTG 6.1.3",
                      "type": "Major Task Group",
                      "color_name": "Cerulean",
                      "hex_code": "#117799",
                      "red": "17",
                      "green": "119",
                      "blue": "153",
                      "major_task_group_title": "Paradigmatic Precision",
                      "major_task_group_description": "Paradigmatic Precision centers on examining core assumptions, frameworks, and mental models that shape how we interpret the world. By challenging deeply held beliefs and applying structured, evidence-based thinking, individuals gain sharper insight into complex problems. This approach prioritizes curiosity, continuous learning, and the willingness to revise or even replace outdated paradigms, enabling more nuanced perspectives and more effective decision-making.",
                      "major_task_group_tagline": "Refining our mental models through precise, questioning insight to reveal deeper truths.",
                      "major_task_group_books_influenced_by": {
                        "book1": "The Structure of Scientific Revolutions by Thomas S. Kuhn",
                        "book2": "Thinking, Fast and Slow by Daniel Kahneman",
                        "book3": "Black Swan by Nassim Nicholas Taleb",
                        "book4": "Freakonomics by Steven D. Levitt and Stephen J. Dubner",
                        "book5": "The Righteous Mind by Jonathan Haidt",
                        "book6": "Range by David Epstein",
                        "book7": "Influence: The Psychology of Persuasion by Robert B. Cialdini"
                      },
                      "Specific_task_groups": {
                        "specific_task_group_1": {
                          "id": "EA-207",
                          "unique_identifier": "STG 6.1.3.1",
