                          "connection_to_the_major_task_group": "Harnessing inner resolve to meet unexpected challenges head‑on, proving that raw determination can reshape destiny.",
                          "specific_task_group_description": "Intense Force guides readers through exercises in focused determination—cultivating the mental grit needed to persevere when circumstances demand unwavering resolve.",
                          "specific_task_group_tagline": "Channel the power within to conquer any obstacle.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Grit",
                              "author": "Angela Duckworth",
                              "section_of_focus": "Building Perseverance",
                              "section_description": "Explores how sustained passion and persistence drive long‑term success, even when talent alone falls short.",
