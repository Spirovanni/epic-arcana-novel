                          "specific_task_group_description": "Abundance‑minded thinking shifts focus from limitation to possibility, encouraging strategic risk‑taking and collaborative success. By valuing shared prosperity, individuals create regenerative cycles of opportunity.",
                          "specific_task_group_tagline": "Prosper through plenty, share through purpose.",
                          "specific_task_group_books_influenced_by": {
