                        "book3": "Willpower: Rediscovering the Greatest Human Strength by Roy F. Baumeister and John Tierney",
                        "book4": "Peak Performance by Brad Stulberg and Steve Magness",
                        "book5": "Eat, Move, Sleep by Tom Rath",
                        "book6": "The Upside of Stress by Kelly McGonigal",
                        "book7": "High Performance Habits by Brendon Burchard"
                      },
