                          "epic_novel_pages": "Pages 301 - 315",
                          "epic_chapter_focus": "Reversal (resolution)",
                          "epic_preliminary_scene_focus": "The Reward",
                          "epic_preliminary_scene_description": "Having endured the supreme ordeal, the Daughter and her allies savor a hard‑won victory, gaining clarity and renewed confidence.",
                          "epic_novel_chapter_focus": "Scene VIII: The Supreme Ordeal",
                          "epic_novel_section_name": "Part II: Chief Among the Mighty",
                          "specific_task_group_title": "Steady Force",
                          "focus_area": "Persistence",
                          "connection_to_the_major_task_group": "Maintaining consistent effort converts fleeting triumphs into lasting progress.",
                          "specific_task_group_description": "Steady Force cultivates discipline and routine, teaching how to sustain momentum through structured habits and unwavering dedication.",
                          "specific_task_group_tagline": "Consistency conquers chaos.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Atomic Habits",
                              "author": "James Clear",
                              "section_of_focus": "Make Habits Stick",
                              "section_description": "Outlines practical strategies for building and maintaining productive routines.",
