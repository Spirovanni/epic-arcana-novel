                    "major_activity_theme_2": {
                      "unique_identifier": "MAT 6.2",
                      "type": "Major Activity Theme",
                      "color_name": "Seagull",
                      "hex_code": "#70B0D0",
                      "red": "112",
                      "green": "176",
                      "blue": "208",
                      "major_task_group_title": "Transformation - On Death Ground",
                      "major_task_group_description": "Transformation – On Death Ground refers to the powerful, urgent shift that happens when individuals find themselves in inescapable, high-stakes situations. Drawing on the metaphor of a strategic position where there is no retreat (as described in military texts like Sun Tzu’s), this state compels profound personal evolution. Such transformative progress arises from necessity: the certainty that failure is not an option. By harnessing the clarity and intensity of these moments, individuals can tap into deep resolve, unveiling hidden strengths and forging a meaningful, renewed sense of purpose.",
                      "major_task_group_tagline": "Catalyzing radical growth through moments where there is no choice but to evolve.",
                      "major_task_group_books_influenced_by": {
                        "book1": "The Art of War by Sun Tzu (modern commentaries on 'Death Ground')",
                        "book2": "Can't Hurt Me by David Goggins",
                        "book3": "Endurance: Shackleton's Incredible Voyage by Alfred Lansing",
                        "book4": "Man's Search for Meaning by Viktor Frankl",
                        "book5": "Unbroken by Laura Hillenbrand",
                        "book6": "The Obstacle Is the Way by Ryan Holiday",
                        "book7": "Grit: The Power of Passion and Perseverance by Angela Duckworth"
                      },
                      "Specific_task_groups": {
                        "specific_task_group_1": {
