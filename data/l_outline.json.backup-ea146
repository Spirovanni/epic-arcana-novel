                      "major_task_group_title": "(Give) Sacrifice",
                      "major_task_group_description": "Sacrifice represents the conscious decision to devote one’s energy, resources, or comfort for a greater cause—whether personal, relational, or communal. By willingly giving up certain conveniences or desires, individuals often cultivate deeper resilience, empathy, and gratitude. Embracing sacrifice can unify goals, strengthen character, and forge meaningful connections rooted in altruism and shared commitment.",
                      "major_task_group_tagline": "Offering up what matters to serve a higher purpose and deepen collective well-being.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Mere Christianity by C.S. Lewis",
                        "book2": "Man’s Search for Meaning by Viktor E. Frankl",
                        "book3": "Give and Take by Adam Grant",
                        "book4": "Start with Why by Simon Sinek",
                        "book5": "Twelve Steps and Twelve Traditions by Alcoholics Anonymous World Services",
                        "book6": "The Altruistic Personality by Samuel P. Oliner and Pearl M. Oliner",
                        "book7": "The Art of Loving by Erich Fromm"
                      },
                      "Specific_task_groups": {
                        "specific_task_group_1": {
