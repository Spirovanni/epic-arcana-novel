                          "epic_novel_pages": "Page 481 - 495",
                          "epic_chapter_focus": "Reaction (set‑up)",
                          "epic_preliminary_scene_focus": "The Reward",
                          "epic_preliminary_scene_description": "",
                          "epic_novel_chapter_focus": "Scene VIII: The Supreme Ordeal",
                          "epic_novel_section_name": "Part II: The Magus Of Power",
                          "specific_task_group_title": "Valor",
                          "focus_area": "Courage",
                          "connection_to_the_major_task_group": "Summoning bravery to face fear and lead by example.",
                          "specific_task_group_description": "Valor is the deliberate choice to act nobly despite danger or doubt. It sets the tone for others, forging trust and inspiring collective boldness.",
                          "specific_task_group_tagline": "Stand firm when all else wavers.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Daring Greatly",
                              "author": "Brené Brown",
                              "section_of_focus": "The Power of Vulnerability",
                              "section_description": "Examines how embracing vulnerability fosters true courage.",
                              "connection_focus_area": "Links vulnerability with courageous leadership.",
