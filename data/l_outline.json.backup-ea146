                      "major_task_group_title": "Existential Integrity",
                      "major_task_group_description": "Existential Integrity underscores living authentically in alignment with one’s core beliefs and values, even in the face of uncertainty. It involves examining fundamental questions about identity, purpose, and morality, then translating these reflections into genuine action and responsibility. By integrating introspection with everyday decisions, individuals cultivate personal congruence, resilience, and a sense of meaning that transcends life’s inevitable challenges.",
                      "major_task_group_tagline": "Bridging thoughtful introspection and purposeful action for a more authentic life.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Man's Search for Meaning by Viktor E. Frankl",
                        "book2": "Being and Nothingness by Jean-Paul Sartre",
                        "book3": "The Denial of Death by Ernest Becker",
                        "book4": "At the Existentialist Café by Sarah Bakewell",
                        "book5": "When Things Fall Apart by Pema Chödrön",
                        "book6": "Staring at the Sun by Irvin D. Yalom",
                        "book7": "Meditations by Marcus Aurelius"
                      },
