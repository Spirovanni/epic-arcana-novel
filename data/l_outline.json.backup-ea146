                            "Francisco": {
                              "current_stage": "The Reward - Harmonic Leadership Development",
                              "emotional_journey": "From mindful practitioner to harmonic leader, learning to create balance and unity in complex social and cosmic situations",
                              "key_realization": "True leadership means helping everyone find their harmonious place within a larger purpose, not imposing one's will on others",
