                "task_master_3": {
                  "unique_identifier": "MT 8.3",
                  "type": "Task Master",
                  "color_name": "Lawn Green",
                  "hex_code": "#7BEA22",
                  "red": "123",
                  "green": "234",
                  "blue": "34",
                  "title": "Conscious Mind",
                  "tagline": "Illuminating our thoughts for intentional action and deeper self-awareness.",
                  "description": "The Conscious Mind is the seat of deliberate awareness where reason, morality, and personal identity converge. By harnessing the power of conscious thought, individuals can guide their decisions and behaviors with clarity and intention. Focusing on self-reflection, curiosity, and present-moment mindfulness empowers people to shape their experiences and forge authentic connections with the world around them. Through conscious engagement, life’s challenges become opportunities for meaningful growth and purposeful action.",
                  "fiction_novel_section_title": "Lord of the Fire of the World",
                  "fiction_novel_section_description": "In 'Lord of the Fire of the World,' a young philosopher-king grapples with her vast kingdom’s demands while striving to maintain lucidity amidst political and personal upheaval. As whispers of a mystical flame spread, she unravels the truth behind a primal source of power said to be governed by focused thought. To protect her realm, she must master the conscious mind’s boundless potential—taming the inferno within and without. Along the way, she discovers that true mastery lies in comprehending not only the mind's rational brilliance but also the emotional undercurrents guiding her every choice.",
                  "fiction_novel_section_tagline": "In the crucible of conscious intention, the world's hidden fires become a guiding light.",
                  "fiction_novel_section_books_influenced_by": {
                    "book1": "Fahrenheit 451 by Ray Bradbury",
                    "book2": "Brave New World by Aldous Huxley",
                    "book3": "The Giver by Lois Lowry",
                    "book4": "Nineteen Eighty-Four by George Orwell",
                    "book5": "Ender’s Game by Orson Scott Card",
                    "book6": "Ubik by Philip K. Dick",
                    "book7": "Solaris by Stanisław Lem"
                  },
                  "major_task_groups": {
                    "major_task_group_1": {
                      "unique_identifier": "MTG 8.3.1",
                      "type": "Major Task Group",
                      "color_name": "Mantis",
                      "hex_code": "#7BC342",
                      "red": "123",
                      "green": "195",
                      "blue": "66",
                      "major_task_group_title": "Radiant Influence",
                      "major_task_group_description": "Radiant Influence is the practice of leading with positive energy and inspiration, igniting motivation in others and creating a ripple effect of transformative change.",
                      "major_task_group_tagline": "Shine your leadership light to empower others to reach their fullest potential.",
                      "major_task_group_books_influenced_by": {
                        "book1": "How to Win Friends and Influence People by Dale Carnegie",
                        "book2": "Influence: The Psychology of Persuasion by Robert B. Cialdini",
                        "book3": "The Power of Positive Leadership by Jon Gordon",
                        "book4": "Quiet Leadership by David Rock",
                        "book5": "The 21 Irrefutable Laws of Leadership by John C. Maxwell",
                        "book6": "Leading with Emotional Courage by Peter Bregman",
                        "book7": "Give and Take by Adam Grant"
                      },
