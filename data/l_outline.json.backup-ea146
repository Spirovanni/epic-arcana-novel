                "task_master_2": {
                  "unique_identifier": "MT 5.2",
                  "type": "Task Master",
                  "color_name": "Dark Blue",
                  "hex_code": "#001188",
                  "red": "0",
                  "green": "17",
                  "blue": "136",
                  "title": "Justice",
                  "tagline": "Striving for fairness and balance in a world of shifting scales.",
                  "description": "Justice embodies the principle of fairness, equality, and moral rightness, serving as the foundation that holds societies together. By pursuing justice, individuals seek to create harmony among people of varying backgrounds and beliefs, recognizing the equal worth of every life and ensuring accountability for actions. Whether addressed at a personal or societal level, the pursuit of justice helps build trust, unity, and compassion, while reminding us that accountability and integrity are vital for true progress.",
                  "fiction_novel_section_title": "Holder of the Balances",
                  "fiction_novel_section_description": "In the fictional novel 'Holder of the Balances,' a once-prosperous land is pushed into chaos by corruption within its governing council. When a wandering magistrate arrives, she stands between warring factions to enforce justice with an unwavering moral code. Her mission is more than punishing crimes: it's about restoring balance and trust among a populace that has lost faith in fairness. Along the way, she confronts personal dilemmas that challenge her ideas of right and wrong, ultimately proving that true justice hinges on empathy, discernment, and an unshakeable dedication to truth.",
                  "fiction_novel_section_tagline": "When fairness prevails, conflicts turn from strife to healing and renewal.",
                  "fiction_novel_section_books_influenced_by": {
                    "book1": "To Kill a Mockingbird by Harper Lee",
                    "book2": "Les Misérables by Victor Hugo",
                    "book3": "12 Angry Men by Reginald Rose (play, often read as a short novel)",
                    "book4": "Monster by Walter Dean Myers",
                    "book5": "The Children of Men by P.D. James",
                    "book6": "The Dispossessed by Ursula K. Le Guin",
                    "book7": "The Left Hand of Darkness by Ursula K. Le Guin"
                  },
                  "major_task_groups": {
                    "major_task_group_1": {
                      "unique_identifier": "MTG 5.2.1",
                      "type": "Major Task Group",
                      "color_name": "Mauve",
                      "hex_code": "#C995FF",
                      "red": "201",
                      "green": "149",
                      "blue": "255",
                      "major_task_group_title": "Philosophical Discernment",
                      "major_task_group_description": "Philosophical Discernment involves integrating wisdom from diverse philosophical traditions into practical, everyday judgment. By combining critical thinking, ethical reflection, and an openness to multiple perspectives, individuals can evaluate complex issues with nuance and moral clarity. Emphasizing both intellectual rigor and empathy, Philosophical Discernment guides people to make decisions that balance personal growth with shared responsibility, ensuring a deeper understanding of oneself and the world.",
                      "major_task_group_tagline": "Wielding timeless wisdom for insight and integrity in everyday choices.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Meditations by Marcus Aurelius",
                        "book2": "Nicomachean Ethics by Aristotle",
                        "book3": "Practical Wisdom by Barry Schwartz and Kenneth Sharpe",
                        "book4": "On the Shortness of Life by Seneca (Modern translations)",
                        "book5": "Justice: What's the Right Thing to Do? by Michael J. Sandel",
                        "book6": "The Righteous Mind by Jonathan Haidt",
                        "book7": "The Structure of Scientific Revolutions by Thomas S. Kuhn"
                      },
