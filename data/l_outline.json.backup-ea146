                          "epic_novel_pages": "Pages 286 - 300",
                          "epic_chapter_focus": "Midpoint",
                          "epic_preliminary_scene_focus": "The Ordeal (Temptation)",
                          "epic_preliminary_scene_description": "At the story’s midpoint, the Daughter must summon inner strength to confront a daunting trial that threatens to break her resolve and reshape her purpose.",
                          "epic_novel_chapter_focus": "Scene VIII: The Supreme Ordeal",
                          "epic_novel_section_name": "Part II: Chief Among the Mighty",
                          "specific_task_group_title": "Backbone",
                          "focus_area": "Resilience",
                          "connection_to_the_major_task_group": "A strong foundation holds the party steady through overwhelming challenges, anchoring hope and purpose.",
                          "specific_task_group_description": "Backbone builds emotional and strategic fortitude by practicing endurance under pressure, reinforcing collective morale and individual perseverance in the face of adversity.",
                          "specific_task_group_tagline": "Stand firm when the storm hits.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Grit",
                              "author": "Angela Duckworth",
                              "section_of_focus": "The Power of Passion and Perseverance",
                              "section_description": "Explores how sustained effort and a clear sense of purpose strengthen character over time.",
                              "connection_focus_area": "Shows that true resilience arises from long‑term commitment to a goal.",
                              "connect_points": {
                                "point1": "Cultivate interests into enduring passions.",
                                "point2": "Set long‑term milestones and celebrate small wins.",
                                "point3": "Maintain effort in spite of setbacks."
                              },
                              "terminal_learning_objectives": {
                                "objective1": "Map personal passion projects and long‑term goals.",
                                "objective2": "Develop resilience routines for stressful periods.",
                                "objective3": "Reflect on past failures to fuel future effort."
                              }
                            },
                            "book2": {
                              "title": "Antifragile",
                              "author": "Nassim Nicholas Taleb",
                              "section_of_focus": "Stressors and Growth",
                              "section_description": "Argues that certain systems grow stronger when exposed to volatility and challenges.",
                              "connection_focus_area": "Demonstrates how controlled adversity can fortify one’s ‘backbone.’",
                              "connect_points": {
                                "point1": "Introduce small challenges to build adaptive capacity.",
                                "point2": "Design feedback loops that reward recovery.",
                                "point3": "Identify stressors that catalyze growth."
                              },
                              "terminal_learning_objectives": {
                                "objective1": "Implement micro‑stress tests in daily routines.",
                                "objective2": "Measure performance improvements post‑challenge.",
                                "objective3": "Adapt strategies based on volatility outcomes."
                              }
                            },
                            "book3": {
                              "title": "Leaders Eat Last",
                              "author": "Simon Sinek",
                              "section_of_focus": "Circle of Safety",
                              "section_description": "Examines how supportive leadership and trust build strong teams capable of weathering crises.",
                              "connection_focus_area": "Highlights the importance of dependable leadership in sustaining group resilience.",
                              "connect_points": {
                                "point1": "Model sacrificial leadership to inspire trust.",
                                "point2": "Establish safe environments for honest feedback.",
                                "point3": "Reinforce collective responsibility during hardship."
                              },
                              "terminal_learning_objectives": {
                                "objective1": "Facilitate trust‑building exercises in teams.",
                                "objective2": "Monitor team cohesion under pressure.",
                                "objective3": "Lead a crisis‑response drill to test unity."
