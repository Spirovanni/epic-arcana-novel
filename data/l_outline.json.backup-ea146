                          "specific_task_group_title": "Valor",
                          "focus_area": "Courage",
                          "connection_to_the_major_task_group": "True bravery emerges when commitment to the mission outshines the fear of loss.",
                          "specific_task_group_description": "Valor here is the steadfast resolve to stand firm in the face of ultimate sacrifice. It inspires collective dedication, forging unity through shared conviction even when the outcome seems bleak.",
                          "specific_task_group_tagline": "Stand unwavering when hope flickers.",
                          "specific_task_group_books_influenced_by": {
