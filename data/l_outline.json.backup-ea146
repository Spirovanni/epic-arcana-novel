                      "major_task_group_title": "Resolute Transformation",
                      "major_task_group_description": "Resolute Transformation encapsulates the determined pursuit of growth, even in the face of formidable pressures or setbacks. By forging an unshakeable commitment to change, individuals harness inner fortitude, clarity of purpose, and strategic adaptability. This unwavering stance—rooted in self-awareness and moral conviction—enables not only personal evolution but also greater capacity to uplift others and confront external challenges with courage and creativity.",
                      "major_task_group_tagline": "Standing firm in the crucible of change to forge enduring personal evolution.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Can't Hurt Me by David Goggins",
                        "book2": "Grit: The Power of Passion and Perseverance by Angela Duckworth",
                        "book3": "Endure by Alex Hutchinson",
                        "book4": "Daring Greatly by Brené Brown",
                        "book5": "Extreme Ownership by Jocko Willink and Leif Babin",
                        "book6": "Atomic Habits by James Clear",
                        "book7": "Mindset: The New Psychology of Success by Carol S. Dweck"
                      },
