                      "major_task_group_title": "Harmonious Integration",
                      "major_task_group_description": "Harmonious Integration emphasizes uniting diverse perspectives, resources, and skills into a seamless, cooperative whole. By valuing collaboration over competition, individuals and groups can weave together complementary strengths to address complex challenges, innovate creatively, and establish a resilient sense of community. This approach celebrates shared goals while honoring personal autonomy, enabling both synergy and respect in the pursuit of collective progress.",
                      "major_task_group_tagline": "Bringing together complementary strengths to create unity, innovation, and enduring collaboration.",
                      "major_task_group_books_influenced_by": {
                        "book1": "The Fifth Discipline by Peter M. Senge",
                        "book2": "Team of Teams by General Stanley McChrystal",
                        "book3": "The Culture Code by Daniel Coyle",
                        "book4": "Tribal Leadership by Dave Logan, John King, and Halee Fischer-Wright",
                        "book5": "Leaders Eat Last by Simon Sinek",
                        "book6": "Nonviolent Communication by Marshall B. Rosenberg",
                        "book7": "Collaboration by Morten T. Hansen"
                      },
