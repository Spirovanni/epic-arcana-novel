                      "major_task_group_title": "Transformation",
                      "major_task_group_description": "Transformation is the profound process by which individuals, organizations, or societies fundamentally change their form or function. It involves breaking free from old patterns, beliefs, or limitations, opening the door to new possibilities, growth, and renewed purpose. By embracing transformation deliberately and adapting to ever-evolving circumstances, we unlock the potential to create lasting, meaningful change in ourselves and the world around us.",
                      "major_task_group_tagline": "Catalyzing radical change to unlock deeper purpose and evolve beyond limitations.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Switch: How to Change Things When Change Is Hard by Chip Heath and Dan Heath",
                        "book2": "Immunity to Change by Robert Kegan and Lisa Laskow Lahey",
                        "book3": "Atomic Habits by James Clear",
                        "book4": "Reinventing Organizations by Frederic Laloux",
                        "book5": "Mindset: The New Psychology of Success by Carol S. Dweck",
                        "book6": "The Art of Possibility by Rosamund Stone Zander and Benjamin Zander",
                        "book7": "The Power of Habit by Charles Duhigg"
                      },
