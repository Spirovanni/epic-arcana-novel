                          "epic_preliminary_scene_focus": "Dark Night of the Soul",
                          "epic_preliminary_scene_description": "Amid crushing despair, the Daughter relies on clear, structured thought—methodically charting each step to survive the Abyss.",
                          "epic_novel_chapter_focus": "Scene XI: The Abyss",
                          "epic_novel_section_name": "Part II: Chief Among the Mighty",
                          "specific_task_group_title": "Methodical",
                          "focus_area": "Strategy",
                          "connection_to_the_major_task_group": "Structured thinking and disciplined planning enable decisive action when stakes are highest.",
                          "specific_task_group_description": "Methodical empowers careful breakdown of complex challenges into manageable steps, ensuring consistency under pressure.",
                          "specific_task_group_tagline": "Plan every step.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Thinking, Fast and Slow",
                              "author": "Daniel Kahneman",
                              "section_of_focus": "System 2 Thinking",
                              "section_description": "Details the value of slow, analytical reasoning in complex decisions.",
