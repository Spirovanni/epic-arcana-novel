                      "major_task_group_title": "Unconditional Support",
                      "major_task_group_description": "Unconditional Support focuses on offering help, empathy, and acceptance to others without preconditions or judgment. By providing a safe space for vulnerability and emotional honesty, individuals can foster deeper trust and nurture personal growth in their relationships. Practicing unconditional support means listening wholeheartedly, embracing compassion, and demonstrating consistent care. This approach empowers both the giver and the recipient, helping them forge bonds rooted in respect, resilience, and a profound sense of belonging.",
                      "major_task_group_tagline": "Providing unwavering acceptance and empathy for the strength and healing of all involved.",
                      "major_task_group_books_influenced_by": {
                        "book1": "The Gifts of Imperfection by Brené Brown",
                        "book2": "Daring Greatly by Brené Brown",
                        "book3": "Nonviolent Communication by Marshall B. Rosenberg",
                        "book4": "Codependent No More by Melody Beattie",
                        "book5": "The Art of Possibility by Rosamund Stone Zander and Benjamin Zander",
                        "book6": "The Power of Kindness by Piero Ferrucci",
                        "book7": "The Five Love Languages by Gary Chapman"
                      },
