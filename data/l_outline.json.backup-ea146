                "task_master_2": {
                  "unique_identifier": "MT 9.2",
                  "type": "Task Master",
                  "color_name": "Highball",
                  "hex_code": "#A19C3B",
                  "red": "161",
                  "green": "156",
                  "blue": "59",
                  "title": "Exploration",
                  "tagline": "Venturing beyond the known to reveal life’s hidden possibilities.",
                  "description": "Exploration is the driving spirit behind discovery—whether that means traversing new lands, probing new fields of knowledge, or diving deep into one’s own internal landscape. It pushes individuals to seek answers, challenge their assumptions, and embrace the unknown. By exploring both the physical and metaphysical realms, people break through limiting beliefs, expand their perspectives, and cultivate a boundless sense of wonder. Ultimately, exploration provides the catalyst for imagination, innovation, and meaningful growth.",
                  "fiction_novel_section_title": "The Great One of the Night of Time",
                  "fiction_novel_section_description": "In the fictional saga The Great One of the Night of Time, an ancient empire collapses after its citizens become complacent, forgetting the very urge to seek beyond their borders. As the protagonist, a curious scribe, stumbles upon lost maps hidden for centuries, she is compelled to embark on a perilous expedition through forbidden regions and forgotten eras. Along the journey, she unearths hidden civilizations, confronts her own fears, and rekindles the empire’s thirst for knowledge. Her quest underscores the notion that when curiosity and courage intertwine, entire worlds—both inner and outer—unfold before us.",
                  "fiction_novel_section_tagline": "Seek the untrodden path, and the world will bloom anew beneath each step.",
                  "fiction_novel_section_books_influenced_by": {
                    "book1": "The Voyage of the Dawn Treader by C.S. Lewis",
                    "book2": "Hyperion by Dan Simmons",
                    "book3": "A Wizard of Earthsea by Ursula K. Le Guin",
                    "book4": "The Road by Cormac McCarthy",
                    "book5": "The Golden Compass by Philip Pullman",
                    "book6": "A Darker Shade of Magic by V.E. Schwab",
                    "book7": "Journey to the Center of the Earth by Jules Verne"
                  },
                  "major_task_groups": {
                    "major_task_group_1": {
                      "unique_identifier": "MTG 9.2.1",
                      "type": "Major Task Group",
                      "color_name": "Sweet Corn",
                      "hex_code": "#FFE47B",
                      "red": "255",
                      "green": "228",
                      "blue": "123",
                      "major_task_group_title": "Embracing Growth Through Grief",
                      "major_task_group_description": "Embracing Growth Through Grief is the process of acknowledging loss and sorrow, channeling adversity into personal transformation, deeper empathy, and renewed purpose.",
                      "major_task_group_tagline": "Harness the healing power of grief to emerge stronger and more compassionate.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Man's Search for Meaning by Viktor E. Frankl",
                        "book2": "Option B by Sheryl Sandberg and Adam Grant",
                        "book3": "On Grief and Grieving by Elisabeth Kübler-Ross and David Kessler",
                        "book4": "The Grief Recovery Handbook by John W. James and Russell Friedman",
                        "book5": "Rising Strong by Brené Brown",
                        "book6": "Resilient by Rick Hanson",
                        "book7": "The Art of Losing by Kevin Young"
                      },
