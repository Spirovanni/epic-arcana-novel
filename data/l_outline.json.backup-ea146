                          "series_connections": {
                            "failure_wisdom": "Francisco's mastery of learning from failure will be crucial for adapting to the setbacks in Books 7-9.",
                            "resilient_leadership": "His ability to fail forward will be essential for maintaining hope and progress during the challenges of the finale."
                          },
                          "summary": "In the cosmic equivalent of the 'all is lost' moment, Francisco learns to embrace and learn from failures frequently to uncover hidden opportunities. He discovers that failing often - and learning from each failure - is essential for developing the resilience and adaptability needed for cosmic guardianship. This paradoxical approach to failure becomes a source of strength.",
                          "pov": "3rd Person Limited",
                          "tense": "Past Tense",
                          "core_emotion": "Growing confidence",
                          "scene_tone": "Determined and purposeful"
                        },
