                      "major_task_group_title": "Justice",
                      "major_task_group_description": "Justice embodies fairness, equality, and ethical responsibility in society and individual actions. Centered on upholding rights and ensuring accountability, justice seeks to create an environment in which all people are afforded dignity and impartial treatment. By fostering transparent governance, moral integrity, and community engagement, justice paves the way for trust, collective well-being, and the resolution of conflicts in a principled manner.",
                      "major_task_group_tagline": "Championing fairness, equality, and moral responsibility to uphold the common good.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Justice: What's the Right Thing to Do? by Michael J. Sandel",
                        "book2": "The Righteous Mind by Jonathan Haidt",
                        "book3": "Nicomachean Ethics by Aristotle (modern translation)",
                        "book4": "A Theory of Justice by John Rawls",
                        "book5": "On Liberty by John Stuart Mill",
                        "book6": "Just Mercy by Bryan Stevenson",
                        "book7": "Why Nations Fail by Daron Acemoglu and James A. Robinson"
