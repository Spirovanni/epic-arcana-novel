                          "save_the_cat_beat": "Consequence",
                          "save_the_cat_beat_goal": "",
                          "plot": "Consequence",
                          "character_arcs": {
                            "Francisco": "Develops emotional intelligence and compassion as leadership tools in the rebellion against fate.",
                            "Wounded_Rebels": "Followers who have suffered losses in their attempts to achieve free will.",
                            "Compassionate_Response": "Francisco's growing ability to provide emotional support and healing for his allies.",
