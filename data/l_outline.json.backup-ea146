                              "saveTheCatBeat": "All Is Lost - playfulness doubles efficiency",
                              "sudowrite_metadata": {
                                "intensity": "high",
                                "pacing": "high_energy_flow",
                                "narrative_mode": "competitive_fun"
                              },
                              "learning_objectives": [
