                          "connection_to_the_major_task_group": "Channeling deep emotion to fuel sustained effort and overcome obstacles.",
                          "specific_task_group_description": "Passion ignites purpose, driving individuals to persevere through challenges. It transforms mundane tasks into meaningful pursuits and rallies teams around shared vision.",
                          "specific_task_group_tagline": "Let fervor be your compass.",
                          "specific_task_group_books_influenced_by": {
