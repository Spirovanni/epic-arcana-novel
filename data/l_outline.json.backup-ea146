                    "major_task_group_7": {
                      "unique_identifier": "MTG 5.2.7",
                      "type": "Major Task Group",
                      "color_name": "Cobalt",
                      "hex_code": "#1155AA",
                      "red": "17",
                      "green": "85",
                      "blue": "170",
                      "major_task_group_title": "Philosophical Insight",
                      "major_task_group_description": "Philosophical Insight involves harnessing wisdom from across diverse traditions—ancient and modern, Eastern and Western—to clarify one’s understanding of life’s complexities. By examining foundational questions about existence, morality, and human nature, individuals can better form coherent worldviews that guide daily choices. Balancing reflection with practical action ensures that philosophy remains a tool for both intellectual development and meaningful real-world impact.",
                      "major_task_group_tagline": "Applying timeless reflections to navigate modern dilemmas with clarity and depth.",
                      "major_task_group_books_influenced_by": {
