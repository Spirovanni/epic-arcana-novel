                    "book2": "Kafka on the Shore by Haruki Murakami",
                    "book3": "Life of Pi by Yann Martel",
                    "book4": "The Ocean at the End of the Lane by Neil Gaiman",
                    "book5": "A Wizard of Earthsea by Ursula K. Le Guin",
                    "book6": "The Fifth Season by N.K. Jemisin",
                    "book7": "The Starless Sea by Erin Morgenstern"
                  },
                  "major_task_groups": {
                    "major_task_group_1": {
                      "unique_identifier": "MTG 1.3.1",
