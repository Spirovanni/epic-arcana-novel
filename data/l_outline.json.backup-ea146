                              "section_description": "Explores how beliefs about ability impact achievement.",
                              "connection_focus_area": "Encourages embracing challenges as pathways to growth.",
                              "connect_points": {
                                "point1": "Frame failures as learning opportunities.",
                                "point2": "Celebrate effort over innate talent.",
