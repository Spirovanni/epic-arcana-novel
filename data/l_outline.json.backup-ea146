                        "book3": "A Random Walk Down Wall Street by Burton G. Malkiel",
                        "book4": "The Millionaire Next Door by Thomas J. Stanley and William D. Danko",
                        "book5": "Basic Economics by Thomas Sowell",
                        "book6": "The Total Money Makeover by Dave Ramsey",
                        "book7": "The Behavior Gap by Carl Richards"
                      },
