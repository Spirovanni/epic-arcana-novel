                        "specific_task_group_3": {
                          "id": "EA-056",
                          "unique_identifier": "STG 2.2.1.3",
                          "all_chapter": 56,
                          "novel_book": 2,
                          "chapter": "Chapter 16",
                          "type": "Specific Task Group",
                          "tarot_card_link": "",
                          "tarot_family": "Disks",
                          "new_tarot_family": "Stones",
                          "tarot_card_item": "Five",
                          "color_name": "Salmon",
                          "hex_code": "#FF7D7D",
                          "red": 255,
                          "green": 125,
                          "blue": 125,
                          "epic_novel_pages": "Pages 226 - 240",
                          "epic_chapter_focus": "Fun and games (event/conflict)",
                          "epic_preliminary_scene_focus": "Tests, Allies and Enemies",
                          "epic_preliminary_scene_description": "Amidst a veneer of camaraderie, hidden challenges surface—alliances fray under pressure and characters must confront losses that test their resolve.",
                          "epic_novel_chapter_focus": "Scene VI: Guardians and Gatekeepers",
                          "epic_novel_section_name": "Part II: Chief Among the Mighty",
                          "specific_task_group_title": "Adversity",
                          "focus_area": "Grit",
                          "connection_to_the_major_task_group": "Facing hardship head-on forges inner strength and sharpens purpose.",
                          "specific_task_group_description": "Adversity equips participants with strategies for enduring setbacks, transforming obstacles into catalysts for growth through perseverance and strategic problem‑solving.",
                          "specific_task_group_tagline": "Embrace the challenge, emerge stronger.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "The Obstacle Is the Way",
                              "author": "Ryan Holiday",
                              "section_of_focus": "Perception, Action, Will",
                              "section_description": "Shows how reframing problems as opportunities can turn adversity into advantage.",
                              "connection_focus_area": "Demonstrates the mindset shifts that convert blockages into breakthroughs.",
                              "connect_points": {
                                "point1": "Reinterpret setbacks as invitations to adapt.",
