                    "major_task_group_3": {
                      "unique_identifier": "MTG 2.2.3",
                      "type": "Major Task Group",
                      "color_name": "Falu Red",
                      "hex_code": "#841B1B",
                      "red": "132",
                      "green": "27",
                      "blue": "27",
                      "major_task_group_title": "Fortitude",
                      "major_task_group_description": "Fortitude is the capacity to remain steadfast, courageous, and resolute in the face of adversity. It involves cultivating inner strength, perseverance, and moral courage to uphold one's values and goals, even under pressure. By embracing fortitude, individuals can transform challenges into opportunities for growth and self-discovery, forging resilience and confidence that sustains them through life’s trials.",
                      "major_task_group_tagline": "Fortitude is unwavering perseverance and moral courage in the face of adversity.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Grit: The Power of Passion and Perseverance by Angela Duckworth",
                        "book2": "The Obstacle Is the Way by Ryan Holiday",
                        "book3": "Can't Hurt Me by David Goggins",
                        "book4": "Resilience: Hard-Won Wisdom for Living a Better Life by Eric Greitens",
                        "book5": "Make Your Bed by Admiral William H. McRaven",
                        "book6": "Extreme Ownership by Jocko Willink and Leif Babin",
                        "book7": "Dare to Lead by Brené Brown"
                      },
                      "Specific_task_groups": {
                        "specific_task_group_1": {
                          "id": "EA-060",
