                          "blue": 0,
                          "epic_novel_pages": "Pages 271 - 285",
                          "epic_chapter_focus": "The Road of Trials",
                          "epic_preliminary_scene_focus": "Approach to the Innermost Cave",
                          "epic_preliminary_scene_description": "Amid escalating tests, creative force must manifest tangibly—new tools, strategies, or alliances come alive, shaping the quest’s direction.",
                          "epic_novel_chapter_focus": "Scene VII: The Road of Trials",
                          "epic_novel_section_name": "Part II: The Magus Of Power",
                          "specific_task_group_title": "Manifesting‑Force",
                          "focus_area": "Creativity",
                          "connection_to_the_major_task_group": "Transforming imagination into concrete value propels the mission through uncertainty.",
                          "specific_task_group_description": "Manifesting‑force channels vision into reality through iterative design, experimentation, and action. Creative energy becomes practical power when disciplined into prototypes, art, or solutions.",
                          "specific_task_group_tagline": "Make ideas real. Shape the unseen.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Creative Confidence",
                              "author": "Tom & David Kelley",
                              "section_of_focus": "Design Thinking",
                              "section_description": "Ignites belief that everyone can innovate and offers tools to act.",
                              "connection_focus_area": "Empowers practical creativity.",
                              "connect_points": {
