                          "epic_preliminary_scene_focus": "Final Image",
                          "epic_preliminary_scene_description": "Francisco achieves complete mastery as the Master of Two Worlds, standing as the ultimate bridge between ordinary and cosmic realms. This grand finale establishes the new beginning for cosmic adventures ahead.",
                          "epic_novel_chapter_focus": "Scene XV: Master of Two Worlds",
