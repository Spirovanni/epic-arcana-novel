                      "blue": "149",
                      "major_task_group_title": "Prosperous Endeavors",
                      "major_task_group_description": "Prosperous Endeavors emphasizes sustainable growth and resource optimization to foster resilience, stability, and ethical success. By combining strategic thinking, effective planning, and value-driven decision-making, individuals and communities can cultivate a strong foundation for achieving meaningful goals, advancing well-being, and leaving a positive impact.",
                      "major_task_group_tagline": "Cultivating sustainable growth and resource optimization for meaningful success.",
                      "major_task_group_books_influenced_by": {
                        "book1": "The Richest Man in Babylon by George S. Clason",
                        "book2": "Think and Grow Rich by Napoleon Hill",
                        "book3": "Rich Dad Poor Dad by Robert T. Kiyosaki",
                        "book4": "Your Money or Your Life by Vicki Robin and Joe Dominguez",
                        "book5": "The Intelligent Investor by Benjamin Graham",
                        "book6": "Abundance by Peter H. Diamandis and Steven Kotler",
                        "book7": "The Prosperity Paradox by Clayton M. Christensen"
                      },
