              "task_masters": {
                "task_master_1": {
                  "unique_identifier": "MT 7.1",
                  "type": "Task Master",
                  "color_name": "Chateau Green",
                  "hex_code": "#3C954D",
                  "red": "60",
                  "green": "149",
                  "blue": "77",
                  "title": "Reconciliation",
                  "tagline": "Healing divides by forging deeper understanding and shared purpose.",
                  "description": "Reconciliation is the act of mending broken bonds, bridging differences, and restoring harmony where conflict once reigned. It involves a willingness to confront past wrongs, acknowledge opposing perspectives, and seek common ground. By embracing reconciliation, individuals and communities can transform discord into unity, forging stronger relationships rooted in respect, empathy, and collective growth.",
                  "fiction_novel_section_title": "Daughter of the Reconcilers",
                  "fiction_novel_section_description": "In the fictional novel 'Daughter of the Reconcilers,' an ancient kingdom teeters on the brink of civil war after generations of territorial feuds. The young heroine, born into a lineage of conflict mediators, embarks on a daunting journey to bridge rifts among rival clans. As she gathers pieces of long-lost lore to repair their fractured history, she learns that reconciliation demands both understanding the past’s wounds and daring to envision a shared future. By sowing empathy among former enemies, she kindles hope and reveals that unity can bloom in even the most arid social landscape.",
                  "fiction_novel_section_tagline": "Where compassion and courage meet, reconciliation brings fractured worlds into harmony.",
                  "fiction_novel_section_books_influenced_by": {
                    "book1": "Peace Like a River by Leif Enger",
                    "book2": "The Inheritance Trilogy by N.K. Jemisin",
                    "book3": "The Blue Sword by Robin McKinley",
                    "book4": "The Chimes by Anna Smaill",
                    "book5": "The Harp of Kings by Juliet Marillier",
                    "book6": "The Dragon Prince (Novelization) by Aaron Ehasz & Melanie McGanney Ehasz",
                    "book7": "The Farseer Trilogy by Robin Hobb"
                  },
                  "major_task_groups": {
                    "major_task_group_1": {
                      "unique_identifier": "MTG 7.1.1",
                      "type": "Major Task Group",
                      "color_name": "Chinook",
                      "hex_code": "#99DDAA",
                      "red": "153",
                      "green": "221",
                      "blue": "170",
                      "major_task_group_title": "Resilient Optimism",
                      "major_task_group_description": "Resilient Optimism is the practice of maintaining a positive, hopeful mindset without denying the reality of challenges. By integrating constructive outlooks with realistic assessments, individuals can remain motivated and solution-focused when faced with hardships. This approach fosters psychological well-being, encourages adaptive problem-solving, and inspires trust and collaboration within communities, demonstrating that a bright perspective can coexist alongside honesty about obstacles to be overcome.",
                      "major_task_group_tagline": "Nurturing a hopeful perspective while staying rooted in real-world challenges.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Learned Optimism by Martin E. P. Seligman",
                        "book2": "Man’s Search for Meaning by Viktor E. Frankl",
                        "book3": "Grit: The Power of Passion and Perseverance by Angela Duckworth",
                        "book4": "The Power of Habit by Charles Duhigg",
                        "book5": "Option B by Sheryl Sandberg and Adam Grant",
                        "book6": "The How of Happiness by Sonja Lyubomirsky",
                        "book7": "Flourish by Martin E. P. Seligman"
                      },
