              "task_masters": {
                "task_master_1": {
                  "unique_identifier": "MT 6.1",
                  "type": "Task Master",
                  "color_name": "Scooter",
                  "hex_code": "#3793A4",
                  "red": "55",
                  "green": "147",
                  "blue": "164",
                  "title": "(Give) Sacrifice",
                  "tagline": "True generosity demands the willingness to give beyond ourselves.",
                  "description": "Sacrifice embodies the idea of giving something up—whether time, effort, resources, or personal desires—to benefit others or a greater cause. It underscores the selfless aspect of generosity, reminding us that progress and community often require the willingness to forego personal comfort. By embracing sacrifice, individuals build empathy, foster unity, and learn to see beyond their own needs, paving the way for deeper connections and collective fulfillment.",
                  "fiction_novel_section_title": "The Spirit of the Mighty Waters",
                  "fiction_novel_section_description": "In this fictional tale, coastal villagers face a catastrophic drought that threatens their livelihoods. The protagonist, driven by love for her family and friends, journeys upriver in search of a hidden reservoir. Throughout her quest, she makes vital sacrifices—leaving behind her home, risking personal safety, and giving her own limited resources—all to restore hope to those she cherishes. Ultimately, she learns that sacrifice, when guided by compassion and unity, can unleash the mightiest current of healing and renewal.",
                  "fiction_novel_section_tagline": "Sacrifice is the deep current flowing between survival and hope.",
                  "fiction_novel_section_books_influenced_by": {
                    "book1": "A Tale of Two Cities by Charles Dickens",
                    "book2": "Harry Potter and the Deathly Hallows by J.K. Rowling",
                    "book3": "Les Misérables by Victor Hugo",
                    "book4": "The Chronicles of Narnia: The Lion, the Witch and the Wardrobe by C.S. Lewis",
                    "book5": "The Hunger Games: Mockingjay by Suzanne Collins",
                    "book6": "All Quiet on the Western Front by Erich Maria Remarque",
                    "book7": "The Return of the King by J.R.R. Tolkien"
                  },
                  "major_task_groups": {
                    "major_task_group_1": {
                      "unique_identifier": "MTG 6.1.1",
                      "type": "Major Task Group",
                      "color_name": "Sky Blue",
                      "hex_code": "#88DDEE",
                      "red": "136",
                      "green": "221",
                      "blue": "238",
                      "major_task_group_title": "Subconscious Awareness",
                      "major_task_group_description": "Subconscious Awareness underscores the profound influence of our unconscious thoughts, emotions, and beliefs on daily decision-making and personal development. By cultivating introspection and actively exploring one’s hidden mental processes—through practices such as dream analysis, guided meditation, or creative expression—individuals can unearth limiting patterns and tap into deeper sources of motivation and insight. Developing Subconscious Awareness fosters self-discovery, emotional resilience, and a more integrated sense of self.",
                      "major_task_group_tagline": "Illuminating the hidden currents of mind to unlock richer understanding and transformation.",
                      "major_task_group_books_influenced_by": {
                        "book1": "The Interpretation of Dreams by Sigmund Freud",
                        "book2": "Man and His Symbols by Carl G. Jung",
                        "book3": "Psycho-Cybernetics by Maxwell Maltz",
                        "book4": "The Power of Your Subconscious Mind by Joseph Murphy",
                        "book5": "Dreaming Yourself Awake by B. Alan Wallace and Brian Hodel",
                        "book6": "Inner Work: Using Dreams and Active Imagination for Personal Growth by Robert A. Johnson",
                        "book7": "Brainstorm: The Power and Purpose of the Teenage Brain by Daniel J. Siegel"
                      },
