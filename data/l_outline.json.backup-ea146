                          "epic_chapter_focus": "Push",
                          "epic_preliminary_scene_focus": "Tests, Allies and Enemies",
                          "epic_preliminary_scene_description": "Characters confront new trials that challenge their established habits, forcing them to adapt tactics and forge unexpected alliances in order to survive.",
                          "epic_novel_chapter_focus": "Scene VI: Guardians and Gatekeepers",
