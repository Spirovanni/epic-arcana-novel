                      "major_task_group_title": "Direction",
                      "focus_area": "Mindfulness",
                      "major_activity_theme_books_influenced_by": {
                        "book1": {
                          "title": "The Miracle of Mindfulness",
                          "author": "Thich Nhat Hanh",
                          "section_of_focus": "Cultivating Awareness",
