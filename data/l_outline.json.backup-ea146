                      "major_task_group_title": "Wisdom",
                      "major_task_group_description": "Wisdom is the capacity to harmonize knowledge, experience, and sound judgment to navigate life’s challenges. It involves recognizing both the deeper truths of the human condition and the practicalities of everyday life. By integrating critical thinking, ethical awareness, and empathy, individuals can adopt a well-rounded perspective that fosters personal growth, responsible decision-making, and meaningful connections with others.",
                      "major_task_group_tagline": "Guiding life through clarity, insight, and ethical discernment.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Practical Wisdom by Barry Schwartz and Kenneth Sharpe",
                        "book2": "Meditations by Marcus Aurelius",
                        "book3": "The Road Less Traveled by M. Scott Peck",
                        "book4": "The Book of Joy by Dalai Lama and Desmond Tutu",
                        "book5": "In Search of Wisdom by Matthieu Ricard, Christophe André, and Alexandre Jollien",
                        "book6": "Living Beautifully with Uncertainty and Change by Pema Chödrön",
                        "book7": "The Art of Happiness by the Dalai Lama and Howard C. Cutler"
                      },
