                          "epic_preliminary_scene_focus": "The Ordeal (Temptation)",
                          "epic_preliminary_scene_description": "A pivotal trial tempts characters to cling to comfort. The lure of safety clashes with the necessity for bold leadership, testing the stability they’ve built.",
                          "epic_novel_chapter_focus": "Scene VIII: The Supreme Ordeal",
                          "epic_novel_section_name": "Part II: The Magus Of Power",
                          "specific_task_group_title": "Stability",
                          "focus_area": "Leadership",
                          "connection_to_the_major_task_group": "Grounded leadership stabilizes teams through upheaval, forging trust and strategic foresight.",
                          "specific_task_group_description": "Stability in leadership balances steadfast principles with adaptive vigilance. By anchoring vision, clarifying roles, and modeling composure, leaders cultivate collective confidence amid turbulence.",
                          "specific_task_group_tagline": "Lead steady, steer strong.",
                          "specific_task_group_books_influenced_by": {
                            "book1": {
                              "title": "Good to Great",
                              "author": "Jim Collins",
                              "section_of_focus": "Level‑5 Leadership",
                              "section_description": "Highlights humility plus fierce resolve as drivers of lasting greatness.",
                              "connection_focus_area": "Embeds stability through disciplined leadership.",
                              "connect_points": {
                                "point1": "Put right people in right seats.",
                                "point2": "Confront brutal facts calmly.",
                                "point3": "Build flywheel momentum."
                              },
                              "terminal_learning_objectives": {
                                "objective1": "Practice level‑5 humility and resolve.",
                                "objective2": "Install disciplined thought and action.",
                                "objective3": "Create enduring organizational culture."
                              }
                            },
                            "book2": {
                              "title": "Turn the Ship Around!",
                              "author": "L. David Marquet",
                              "section_of_focus": "Leader‑Leader Model",
                              "section_description": "Shows how decentralizing authority raises engagement and performance.",
                              "connection_focus_area": "Provides stable structures through empowered crews.",
                              "connect_points": {
                                "point1": "Shift from permission to intent.",
                                "point2": "Embed competence and clarity.",
                                "point3": "Institutionalize continuous learning."
                              },
                              "terminal_learning_objectives": {
                                "objective1": "Delegate decision authority.",
                                "objective2": "Train teams for mastery.",
                                "objective3": "Sustain feedback‑rich cultures."
                              }
                            },
                            "book3": {
                              "title": "Radical Candor",
                              "author": "Kim Scott",
                              "section_of_focus": "Care Personally, Challenge Directly",
                              "section_description": "Promotes candid feedback built on genuine care.",
                              "connection_focus_area": "Maintains stable relationships via honest dialogue.",
                              "connect_points": {
                                "point1": "Establish psychological safety.",
                                "point2": "Deliver clear, kind criticism.",
                                "point3": "Praise specifically and immediately."
                              },
                              "terminal_learning_objectives": {
                                "objective1": "Upgrade feedback conversations.",
                                "objective2": "Balance empathy with accountability.",
                                "objective3": "Embed candor into team norms."
