                              "author": "Brené Brown",
                              "section_of_focus": "Vulnerability and Courage",
                              "section_description": "Reveals how openness fuels authentic confidence.",
                              "connection_focus_area": "Links self‑esteem to courageous vulnerability.",
                              "connect_points": {
                                "point1": "Redefine vulnerability as strength.",
                                "point2": "Disarm shame via honest dialogue.",
                                "point3": "Foster belonging through authenticity."
                              },
                              "terminal_learning_objectives": {
