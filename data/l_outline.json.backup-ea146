                      "major_task_group_title": "(Cardio) Swiftness",
                      "major_task_group_description": "Swiftness captures the energizing and fast-paced quality of moving decisively, whether in terms of physical fitness, mental agility, or quick decision-making. Incorporating elements of cardiovascular endurance, consistent training, and focused energy ensures that one can meet challenges with vigor and responsiveness. By emphasizing both physical capacity and mental resilience, Swiftness becomes an avenue to harness and direct vitality, fostering immediate action and heightened engagement.",
                      "major_task_group_tagline": "Propelling mind and body into synchronized, rapid strides toward improvement and success.",
                      "major_task_group_books_influenced_by": {
                        "book1": "Spark: The Revolutionary New Science of Exercise and the Brain by John J. Ratey",
                        "book2": "Endure: Mind, Body, and the Curiously Elastic Limits of Human Performance by Alex Hutchinson",
                        "book3": "Peak Performance by Brad Stulberg and Steve Magness",
                        "book4": "Ultramarathon Man: Confessions of an All-Night Runner by Dean Karnazes",
                        "book5": "Fast After 50 by Joe Friel",
                        "book6": "What I Talk About When I Talk About Running by Haruki Murakami",
                        "book7": "Atomic Habits by James Clear"
                      },
