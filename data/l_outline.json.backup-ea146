                          "epic_novel_chapter_focus": "Scene IV: Allies, Mentors, and Helpers",
                          "epic_novel_section_name": "Part I: Daughter of the Mighty Ones",
                          "specific_task_group_title": "Instability",
                          "focus_area": "Adaptability",
                          "connection_to_the_major_task_group": "Embracing uncertainty fosters creativity and reveals hidden strengths.",
                          "specific_task_group_description": "Instability offers methods—scenario planning, rapid prototyping, and resilience drills—to help participants pivot effectively when the ground shifts beneath them.",
                          "specific_task_group_tagline": "Bend without breaking.",
                          "specific_task_group_books_influenced_by": {
