  "assessmentQuestions": {
    "situationalScenarios": [
      {
        "id": "scenario_1",
        "category": "decision_making",
        "scenario": "You discover an ancient, mysterious book in a library. What do you do first?",
        "options": [
          {
            "text": "Carefully research its history and authenticity",
            "scoring": {
              "openness": 2,
              "conscientiousness": 3,
              "playerType": ["book3_theWisdomKeeper", "book1_theAwakening"]
            }
          },
          {
            "text": "Open it immediately and start reading",
            "scoring": {
              "openness": 3,
              "extraversion": 2,
              "neuroticism": -1,
              "playerType": ["book2_theSeeker", "book1_theAwakening"]
            }
          },
          {
            "text": "Find others to explore it with",
            "scoring": {
              "extraversion": 3,
              "agreeableness": 2,
              "playerType": ["book7_theHealer", "book4_theChampion"]
            }
          },
          {
            "text": "Check if it's valuable and plan how to use it",
            "scoring": {
              "conscientiousness": 3,
              "agreeableness": -1,
              "playerType": ["book9_theLeader", "book6_theAlchemist"]
            }
          }
        ]
      },
      {
        "id": "scenario_2",
        "category": "conflict_resolution",
        "scenario": "Two friends are in a heated argument. How do you respond?",
        "options": [
          {
            "text": "Listen to both sides and help them find common ground",
            "scoring": {
              "agreeableness": 3,
              "extraversion": 1,
              "playerType": ["book7_theHealer", "book3_theWisdomKeeper"]
            }
          },
          {
            "text": "Stay out of it - it's not your business",
            "scoring": {
              "agreeableness": -2,
              "neuroticism": -1,
              "playerType": ["book2_theSeeker", "book5_theRevolutionary"]
            }
          },
          {
            "text": "Take charge and settle the dispute firmly",
            "scoring": {
              "conscientiousness": 2,
              "extraversion": 2,
              "agreeableness": -1,
              "playerType": ["book9_theLeader", "book4_theChampion"]
            }
          },
          {
            "text": "Try to lighten the mood with humor or distraction",
            "scoring": {
              "extraversion": 2,
              "agreeableness": 2,
              "neuroticism": -1,
              "playerType": ["book1_theAwakening", "book8_theArtist"]
            }
          }
        ]
      },
      {
        "id": "scenario_3",
        "category": "creativity_expression",
        "scenario": "You have a brilliant idea for a project. What's your approach?",
        "options": [
          {
            "text": "Start creating immediately while inspiration is fresh",
            "scoring": {
              "openness": 3,
              "conscientiousness": -1,
              "extraversion": 1,
              "playerType": ["book8_theArtist", "book2_theSeeker"]
            }
          },
          {
            "text": "Research thoroughly and create a detailed plan",
            "scoring": {
              "conscientiousness": 3,
              "openness": 1,
              "playerType": ["book3_theWisdomKeeper", "book9_theLeader"]
            }
          },
          {
            "text": "Find collaborators who share your vision",
            "scoring": {
              "extraversion": 3,
              "agreeableness": 2,
              "playerType": ["book4_theChampion", "book7_theHealer"]
            }
          },
          {
            "text": "Consider how it could disrupt existing systems",
            "scoring": {
              "openness": 2,
              "agreeableness": -1,
              "conscientiousness": -1,
              "playerType": ["book5_theRevolutionary", "book6_theAlchemist"]
            }
          }
        ]
      }
    ],
    
