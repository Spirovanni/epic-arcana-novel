  "psychologicalFrameworks": {
    "bigFive": {
      "openness": {
        "description": "Curiosity, creativity, openness to experience",
        "trionfiMapping": ["The Fool", "The Magician", "The Star"]
      },
      "conscientiousness": {
        "description": "Organization, discipline, goal-oriented behavior",
        "trionfiMapping": ["The Emperor", "Justice", "The Hermit"]
      },
      "extraversion": {
        "description": "Energy from external world, social interaction",
        "trionfiMapping": ["The Sun", "Strength", "The World"]
      },
      "agreeableness": {
        "description": "Cooperation, trust, empathy",
        "trionfiMapping": ["The Lovers", "Temperance", "The High Priestess"]
      },
      "neuroticism": {
        "description": "Emotional stability vs. anxiety and stress",
        "trionfiMapping": ["The Tower", "Death", "The Devil"]
      }
    },
    
    "jungianArchetypes": {
      "theInnocent": {
        "description": "Pure, optimistic, seeks harmony",
        "bookAlignment": 1,
        "shadowAspect": "naive, denial of reality"
      },
      "theExplorer": {
        "description": "Seeks freedom, authentic experience",
        "bookAlignment": 2,
        "shadowAspect": "restless, never satisfied"
      },
      "theSage": {
        "description": "Seeks truth and understanding",
        "bookAlignment": 3,
        "shadowAspect": "dogmatic, overcomplicated"
      },
      "theHero": {
        "description": "Courageous, determined, proves worth",
        "bookAlignment": 4,
        "shadowAspect": "arrogant, ruthless"
      },
      "theOutlaw": {
        "description": "Breaks rules, seeks revolution",
        "bookAlignment": 5,
        "shadowAspect": "criminal, self-destructive"
      },
      "theMagician": {
        "description": "Transforms reality, visionary",
        "bookAlignment": 6,
        "shadowAspect": "manipulative, megalomaniac"
      },
      "theCaregiver": {
        "description": "Helps others, compassionate",
        "bookAlignment": 7,
        "shadowAspect": "martyrdom, enabling"
      },
      "theCreator": {
        "description": "Creates enduring value, artistic",
        "bookAlignment": 8,
        "shadowAspect": "perfectionist, narcissistic"
      },
      "theRuler": {
        "description": "Takes responsibility, creates order",
        "bookAlignment": 9,
        "shadowAspect": "tyrannical, authoritarian"
      }
    }
  },
  
