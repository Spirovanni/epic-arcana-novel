  "assessmentSystem": {
    "name": "Epic Arcana Player Type & Role Assessment",
    "description": "A comprehensive personality assessment combining Jungian psychology, Big Five traits, Enneagram wisdom, and Trionfi archetypes for the 9-book Epic Arcana saga",
