  "scoringSystem": {
    "methodology": "Weighted combination of Big Five traits, archetypal alignment, and situational responses",
    "primaryTypeSelection": "Highest combined score across trait alignment and scenario responses",
    "secondaryTypeThreshold": 0.8,
    "colorCycleCalculation": {
      "formula": "((primaryType.baseDay + (personalityScore * 0.1)) % 360) + 1",
      "description": "Maps personality score to specific days in the 360-day cycle"
    },
    "traitWeighting": {
      "openness": 0.25,
      "conscientiousness": 0.2,
      "extraversion": 0.2,
      "agreeableness": 0.2,
      "neuroticism": 0.15
    }
  },
  
